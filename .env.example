# Neon pooled connection string (the host contains `-pooler`).
DATABASE_URL=

# Neon Auth (Managed Better Auth). Enable Auth in the Neon console
# (Project → Branch → Auth → Enable Auth), then copy the Auth URL
# from the Configuration tab.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Signs the local session cache cookie. Must be 32+ characters.
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Only this email may use the app after a Neon sign-in. Anyone else who
# registers lands on a "not the owner" page.
OWNER_EMAIL=you@example.com

# Web Push VAPID keypair. Generate with:
#   npx web-push generate-vapid-keys
# Apple's push service requires VAPID_SUBJECT to be a mailto: or https: URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash QStash. Leave blank to run locally without timed delivery
# (Send now / Run tick on the Log page still work).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Regional API. Required if your QStash console is US (the SDK default is EU).
# US: https://qstash-us-east-1.upstash.io
# EU: https://qstash.upstash.io
QSTASH_URL=https://qstash-us-east-1.upstash.io

# Public origin QStash posts back to. Must be the production domain, not a
# preview URL — QStash messages outlive the deployment that created them.
APP_BASE_URL=https://your-app.vercel.app

# How far ahead pending reminders are handed to QStash (hours).
SCHEDULING_HORIZON_HOURS=48

# Set to 1 to keep planning notifications in the DB but never talk to QStash.
# DISABLE_SCHEDULING=1
